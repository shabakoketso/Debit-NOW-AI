# Communications Commands Center
SMS_GATEWAY=mock
SMS_API_KEY=your_sms_gateway_api_key
SMS_GATEWAY_URL=https://your-sms-provider.example/messages
OTP_VALID_MINUTES=5
OTP_MAX_ATTEMPTS=3
OTP_PEPPER=replace_with_a_long_random_secret

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
